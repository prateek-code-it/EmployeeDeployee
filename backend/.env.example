# Copy this file to .env and fill in your real values
# Never commit the real .env file to git

PORT=5000

# PostgreSQL connection (match what you set up earlier)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=construction_app
DB_USER=app_user
DB_PASSWORD=your-real-db-password

# JWT secret - use a long random string in production
# generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-this-with-a-long-random-string
JWT_EXPIRES_IN=8h

# Initial admin account (used only by scripts/create-admin.js)
ADMIN_LOGIN_ID=admin
ADMIN_PASSWORD=********
ADMIN_NAME=Admin
